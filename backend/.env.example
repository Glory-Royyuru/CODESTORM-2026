# SATG backend configuration reference. Every variable is optional; the
# values below are the built-in defaults (backend/app/config.py).
#
# The backend does NOT load .env files. Set these as real environment
# variables in the shell that starts uvicorn, e.g.
#   PowerShell:  $env:ML_MODE = "required"
#   bash:        export ML_MODE=required
# Invalid values stop the backend at start-up instead of being replaced.

# --- Request integrity (HMAC-SHA256 tag on every ALLOW) ---------------------
# At least 32 bytes. Unset: a random per-process key is generated, so tags
# only verify while that process runs. Never commit a real value. An empty
# value is rejected, so leave the line commented out unless you set one.
# SATG_GATEWAY_HMAC_SECRET=

# --- Audit API (GET /v1/audit/events, read-only) -----------------------------
# Operator bearer token, at least 32 characters. Unset: the audit API is
# disabled (503). Give the same value to the console's Next.js server
# (frontend/.env.local), never to the browser. Never commit a real value.
# SATG_AUDIT_API_TOKEN=

# --- ML risk layer -----------------------------------------------------------
# required: ML unavailable/error/timeout -> BLOCK ML-003 (fail closed)
# advisory: ML unavailable/error/timeout -> deterministic decision stands
# off:      ML not consulted
ML_MODE=required
# Seconds one prediction may take (0.1-30). Model loading is not included.
ML_TIMEOUT_SECONDS=3.0
# fused_risk >= high -> ESCALATE (ML-001); >= critical -> BLOCK (ML-002).
ML_HIGH_RISK_THRESHOLD=0.60
ML_CRITICAL_RISK_THRESHOLD=0.80
# Default: <repo>/ml and <repo>/ml/artifacts.
ML_PACKAGE_DIR=
ML_MODEL_PATH=
# The loaded model must report exactly this version, or it is refused.
ML_MODEL_VERSION=satg-ml-v0.1

# --- Docker sandbox (only a final ALLOW is executed) --------------------------
# docker: run in a disposable container; off: verdict only, nothing executed.
# There is no host fallback: if Docker is unavailable, nothing runs.
SANDBOX_MODE=docker
# Built locally from sandbox/ (docker build -t satg-sandbox:0.1 sandbox/); never pulled.
SANDBOX_IMAGE=satg-sandbox:0.1
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
# Seconds (1-120), container start-up included. The frontend proxy waits 25 s
# in total (frontend/src/lib/satg/proxy.ts); raise it if you raise this.
SANDBOX_TIMEOUT=10
SANDBOX_MAX_OUTPUT_BYTES=16384
DOCKER_BIN=docker
