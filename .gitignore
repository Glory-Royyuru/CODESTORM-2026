# Repository-wide ignores. frontend/ and backend/ have their own .gitignore
# files for tool-specific output (node_modules, .next, venv, ...).

# Local environment files — never commit real values. Templates are allowed.
.env
.env.*
!.env.example

# Python bytecode, caches and virtual environments (any directory)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Training datasets are cloned locally (see ml/README.md), never committed.
ml/data/raw/AgentDrift/
ml/data/raw/InjecAgent/

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
