# Repository-wide ignores. frontend/ and backend/ have their own .gitignore
# files for tool-specific output (node_modules, .next, venv, ...).

# Local environment files — never commit real values. Templates are allowed.
.env
.env.*
!.env.example

# Python bytecode and caches (any directory)
__pycache__/
*.py[cod]
.pytest_cache/

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
