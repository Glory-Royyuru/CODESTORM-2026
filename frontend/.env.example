# Copy to .env.local to override. All variables are optional.

# Where the Next.js server forwards Live Gateway requests (server-side only,
# never sent to the browser). Must be an http(s) URL.
SATG_BACKEND_URL=http://127.0.0.1:8000

# Operator token for the backend's read-only audit API (Audit page, Live audit).
# Server-side only: the proxy adds it to backend requests; it is never sent to
# the browser. Must equal the backend's SATG_AUDIT_API_TOKEN. Never commit it.
# SATG_AUDIT_API_TOKEN=
